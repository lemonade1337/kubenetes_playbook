apiVersion: v1
kind: Service
metadata:
  name: {{ postgres_service_name }}
  namespace: {{ k8s_namespace }}
  labels:
    app.kubernetes.io/name: postgresql
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  ports:
  - port: {{ postgres_port }}
    targetPort: {{ postgres_port }}
    name: postgres
  - port: 9187
    targetPort: 9187
    name: metrics
  selector:
    app: postgres
