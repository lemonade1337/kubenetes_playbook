apiVersion: autoscaling/v2
kind: HorizontalPodAutoscaler
metadata:
  name: qwen-llm-hpa
  namespace: {{ k8s_namespace }}
  labels:
    app: qwen-llm
    app.kubernetes.io/name: qwen-llm
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  scaleTargetRef:
    apiVersion: apps/v1
    kind: Deployment
    name: qwen-llm
  minReplicas: {{ qwen_min_replicas }}
  maxReplicas: {{ qwen_max_replicas }}
  metrics:
  - type: Resource
    resource:
      name: cpu
      target:
        type: Utilization
        averageUtilization: {{ qwen_hpa_cpu_percent }}
  behavior:
    scaleUp:
      stabilizationWindowSeconds: 0
      policies:
      - type: Pods
        value: 1
        periodSeconds: 15
      - type: Percent
        value: 100
        periodSeconds: 15
      selectPolicy: Max
    scaleDown:
      stabilizationWindowSeconds: 120
      policies:
      - type: Pods
        value: 1
        periodSeconds: 60
