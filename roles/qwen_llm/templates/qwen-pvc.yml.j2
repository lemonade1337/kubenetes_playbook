apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: qwen-model-cache-pvc
  namespace: {{ k8s_namespace }}
  labels:
    app: qwen-llm
    app.kubernetes.io/name: qwen-llm
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  accessModes:
    - ReadWriteOnce
{% if k8s_storage_class is defined and k8s_storage_class != "" and k8s_storage_class != "default" %}
  storageClassName: "{{ k8s_storage_class }}"
{% endif %}
  resources:
    requests:
      storage: {{ qwen_storage_size }}
