apiVersion: apps/v1
kind: Deployment
metadata:
  name: qwen-llm
  namespace: {{ k8s_namespace }}
  labels:
    app: qwen-llm
    app.kubernetes.io/name: qwen-llm
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  replicas: {{ qwen_min_replicas }} # Starts at 1 instance
  selector:
    matchLabels:
      app: qwen-llm
  template:
    metadata:
      labels:
        app: qwen-llm
        app.kubernetes.io/name: qwen-llm
        app.kubernetes.io/part-of: qwen-ai-platform
    spec:
      affinity:
        podAntiAffinity:
          preferredDuringSchedulingIgnoredDuringExecution:
          - weight: 100
            podAffinityTerm:
              labelSelector:
                matchExpressions:
                - key: app
                  operator: In
                  values:
                  - qwen-llm
              topologyKey: "kubernetes.io/hostname"
      containers:
      - name: qwen-inference
        image: {{ qwen_image }}
        imagePullPolicy: IfNotPresent
        ports:
        - name: http
          containerPort: {{ qwen_port }}
        env:
        - name: OLLAMA_KEEP_ALIVE
          value: "24h"
        - name: OLLAMA_NUM_PARALLEL
          value: "1" # Ensures 1 concurrent slot per pod so load triggers autoscaling!
        resources:
          requests:
            cpu: "{{ qwen_cpu_request }}"
            memory: "{{ qwen_memory_request }}"
          limits:
            cpu: "{{ qwen_cpu_limit }}"
            memory: "{{ qwen_memory_limit }}"
        readinessProbe:
          httpGet:
            path: /api/tags
            port: {{ qwen_port }}
          initialDelaySeconds: 2
          periodSeconds: 3
          timeoutSeconds: 3
        livenessProbe:
          httpGet:
            path: /api/tags
            port: {{ qwen_port }}
          initialDelaySeconds: 10
          periodSeconds: 15
          timeoutSeconds: 5
