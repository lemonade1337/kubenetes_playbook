apiVersion: v1
kind: Service
metadata:
  name: {{ prometheus_service_name }}
  namespace: {{ k8s_namespace }}
  labels:
    app: prometheus
    app.kubernetes.io/name: prometheus
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  type: NodePort
  ports:
  - port: {{ prometheus_port }}
    targetPort: {{ prometheus_port }}
    nodePort: {{ nodeport_prometheus }}
    name: http
  selector:
    app: prometheus
