apiVersion: v1
kind: Service
metadata:
  name: {{ jaeger_service_name }}
  namespace: {{ k8s_namespace }}
  labels:
    app: jaeger
    app.kubernetes.io/name: jaeger
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  type: ClusterIP
  ports:
  - port: {{ jaeger_ui_port }}
    targetPort: {{ jaeger_ui_port }}
    name: ui
  - port: {{ jaeger_otlp_grpc_port }}
    targetPort: {{ jaeger_otlp_grpc_port }}
    name: otlp-grpc
  - port: {{ jaeger_otlp_http_port }}
    targetPort: {{ jaeger_otlp_http_port }}
    name: otlp-http
  - port: 14268
    targetPort: 14268
    name: collector-http
  - port: 6831
    targetPort: 6831
    protocol: UDP
    name: jaeger-compact
  selector:
    app: jaeger
---
apiVersion: v1
kind: Service
metadata:
  name: {{ jaeger_service_name }}-ui
  namespace: {{ k8s_namespace }}
  labels:
    app: jaeger
    app.kubernetes.io/name: jaeger-ui
    app.kubernetes.io/part-of: qwen-ai-platform
spec:
  type: NodePort
  ports:
  - port: {{ jaeger_ui_port }}
    targetPort: {{ jaeger_ui_port }}
    nodePort: {{ nodeport_jaeger }}
    name: ui
  selector:
    app: jaeger
