apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-datasources
  namespace: {{ k8s_namespace }}
  labels:
    app: grafana
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: qwen-ai-platform
data:
  datasources.yaml: |
    apiVersion: 1
    datasources:
      - name: Prometheus
        type: prometheus
        access: proxy
        url: http://{{ prometheus_service_name }}:{{ prometheus_port }}
        isDefault: true
        editable: false
      - name: Jaeger
        type: jaeger
        access: proxy
        url: http://{{ jaeger_service_name }}:{{ jaeger_ui_port }}
        editable: false
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboard-providers
  namespace: {{ k8s_namespace }}
  labels:
    app: grafana
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: qwen-ai-platform
data:
  dashboards.yaml: |
    apiVersion: 1
    providers:
      - name: 'LLM Platform'
        orgId: 1
        folder: 'LLM Platform'
        type: file
        disableDeletion: false
        editable: true
        options:
          path: /var/lib/grafana/dashboards
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: grafana-dashboards
  namespace: {{ k8s_namespace }}
  labels:
    app: grafana
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: qwen-ai-platform
data:
  overview.json: |
{% raw %}
    {
      "annotations": { "list": [] },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 0,
      "id": null,
      "links": [],
      "liveNow": false,
      "panels": [
        {
          "title": "Platform Health & Scrape Targets",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
          "targets": [
            { "expr": "up", "legendFormat": "{{job}}", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "red", "value": null },
                  { "color": "green", "value": 1 }
                ]
              }
            }
          }
        },
        {
          "title": "Active Qwen In-Flight Requests",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
          "targets": [
            { "expr": "qwen_active_requests", "legendFormat": "Active Requests", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  { "color": "blue", "value": null },
                  { "color": "orange", "value": 3 },
                  { "color": "red", "value": 6 }
                ]
              }
            }
          }
        },
        {
          "title": "Total Tokens Consumed",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
          "targets": [
            { "expr": "llm_tokens_consumed_total", "legendFormat": "Tokens", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" },
              "unit": "short"
            }
          }
        },
        {
          "title": "Registered Users",
          "type": "stat",
          "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
          "targets": [
            { "expr": "llm_registered_users_total", "legendFormat": "Users", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "color": { "mode": "palette-classic" }
            }
          }
        },
        {
          "title": "PostgreSQL Active Connections",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
          "targets": [
            { "expr": "pg_stat_database_numbackends{datname!~\"template.*\"}", "legendFormat": "{{datname}}", "refId": "A" }
          ]
        },
        {
          "title": "PostgreSQL Transaction Commits / Sec",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
          "targets": [
            { "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[1m])", "legendFormat": "{{datname}} commits/s", "refId": "A" }
          ]
        },
        {
          "title": "Keycloak Uptime & Status",
          "type": "stat",
          "gridPos": { "h": 6, "w": 12, "x": 0, "y": 13 },
          "targets": [
            { "expr": "up{job=\"keycloak\"}", "legendFormat": "Keycloak Service", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "HEALTHY", "color": "green" } } }
              ]
            }
          }
        },
        {
          "title": "PostgreSQL Database Sizes (Bytes)",
          "type": "timeseries",
          "gridPos": { "h": 6, "w": 12, "x": 12, "y": 13 },
          "targets": [
            { "expr": "pg_database_size_bytes{datname!~\"template.*\"}", "legendFormat": "{{datname}}", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            }
          }
        }
      ],
      "refresh": "5s",
      "schemaVersion": 38,
      "style": "dark",
      "tags": ["llm", "kubernetes", "postgres", "keycloak", "overview"],
      "time": { "from": "now-15m", "to": "now" },
      "timepicker": {},
      "timezone": "",
      "title": "LLM Platform Overview",
      "uid": "llm-platform-overview"
    }
{% endraw %}
  postgres.json: |
{% raw %}
    {
      "annotations": { "list": [] },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 0,
      "id": null,
      "links": [],
      "liveNow": false,
      "panels": [
        {
          "title": "PostgreSQL Exporter Status",
          "type": "stat",
          "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
          "targets": [
            { "expr": "pg_up", "legendFormat": "PostgreSQL Up", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } }
              ]
            }
          }
        },
        {
          "title": "Active Connections by Database",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 18, "x": 6, "y": 0 },
          "targets": [
            { "expr": "pg_stat_database_numbackends{datname!~\"template.*\"}", "legendFormat": "{{datname}}", "refId": "A" }
          ]
        },
        {
          "title": "Transaction Commits Rate",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
          "targets": [
            { "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*\"}[1m])", "legendFormat": "{{datname}} commits/s", "refId": "A" }
          ]
        },
        {
          "title": "Transaction Rollbacks Rate",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
          "targets": [
            { "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*\"}[1m])", "legendFormat": "{{datname}} rollbacks/s", "refId": "A" }
          ]
        },
        {
          "title": "Database Disk Size",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
          "targets": [
            { "expr": "pg_database_size_bytes{datname!~\"template.*\"}", "legendFormat": "{{datname}}", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "bytes"
            }
          }
        },
        {
          "title": "Blocks Read vs Hit (Buffer Cache)",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
          "targets": [
            { "expr": "rate(pg_stat_database_blks_hit{datname!~\"template.*\"}[1m])", "legendFormat": "{{datname}} cache hits/s", "refId": "A" },
            { "expr": "rate(pg_stat_database_blks_read{datname!~\"template.*\"}[1m])", "legendFormat": "{{datname}} disk reads/s", "refId": "B" }
          ]
        }
      ],
      "refresh": "5s",
      "schemaVersion": 38,
      "style": "dark",
      "tags": ["postgres", "database"],
      "time": { "from": "now-15m", "to": "now" },
      "timepicker": {},
      "timezone": "",
      "title": "PostgreSQL Metrics",
      "uid": "postgres-metrics"
    }
{% endraw %}
  keycloak.json: |
{% raw %}
    {
      "annotations": { "list": [] },
      "editable": true,
      "fiscalYearStartMonth": 0,
      "graphTooltip": 0,
      "id": null,
      "links": [],
      "liveNow": false,
      "panels": [
        {
          "title": "Keycloak Availability",
          "type": "stat",
          "gridPos": { "h": 5, "w": 8, "x": 0, "y": 0 },
          "targets": [
            { "expr": "up{job=\"keycloak\"}", "legendFormat": "Keycloak Up", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "ONLINE", "color": "green" } } }
              ]
            }
          }
        },
        {
          "title": "Scrape Duration",
          "type": "timeseries",
          "gridPos": { "h": 5, "w": 16, "x": 8, "y": 0 },
          "targets": [
            { "expr": "scrape_duration_seconds{job=\"keycloak\"}", "legendFormat": "Scrape Duration", "refId": "A" }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            }
          }
        },
        {
          "title": "Keycloak HTTP Request / Response Metrics",
          "type": "timeseries",
          "gridPos": { "h": 8, "w": 24, "x": 0, "y": 5 },
          "targets": [
            { "expr": "rate(http_server_requests_seconds_count[1m])", "legendFormat": "{{status}} - {{uri}}", "refId": "A" }
          ]
        }
      ],
      "refresh": "5s",
      "schemaVersion": 38,
      "style": "dark",
      "tags": ["keycloak", "auth"],
      "time": { "from": "now-15m", "to": "now" },
      "timepicker": {},
      "timezone": "",
      "title": "Keycloak Metrics",
      "uid": "keycloak-metrics"
    }
{% endraw %}
