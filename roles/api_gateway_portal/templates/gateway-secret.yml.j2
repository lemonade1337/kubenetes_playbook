apiVersion: v1
kind: Secret
metadata:
  name: api-gateway-secret
  namespace: {{ k8s_namespace }}
  labels:
    app.kubernetes.io/name: api-gateway
    app.kubernetes.io/part-of: qwen-ai-platform
type: Opaque
stringData:
  SECRET_KEY: "{{ gateway_secret_key }}"
  POSTGRES_USER: "{{ postgres_user }}"
  POSTGRES_PASSWORD: "{{ postgres_password }}"
  POSTGRES_HOST: "{{ postgres_service_name }}"
  POSTGRES_PORT: "{{ postgres_port }}"
  POSTGRES_DB: "{{ postgres_portal_db }}"
  KEYCLOAK_URL: "http://{{ keycloak_service_name }}:{{ keycloak_port }}{{ keycloak_http_relative_path }}"
  KEYCLOAK_REALM: "{{ keycloak_realm_name }}"
  KEYCLOAK_CLIENT_ID: "{{ keycloak_client_id }}"
  KEYCLOAK_CLIENT_SECRET: "{{ keycloak_client_secret }}"
  QWEN_BACKEND_URL: "http://{{ qwen_service_name }}:{{ qwen_port }}"
  QWEN_MODEL_NAME: "{{ qwen_model_name }}"
  OTEL_EXPORTER_OTLP_ENDPOINT: "http://{{ jaeger_service_name }}:{{ jaeger_otlp_http_port }}"
  OTEL_SERVICE_NAME: "api-gateway-portal"
  TRACING_ENABLED: "true"
